# ===== LOCALIS AI — Variables de entorno (todas opcionales, con fallback seguro) =====
# Copia a `.env.local` para desarrollo. En Vercel: Project Settings > Environment Variables.

# Next.js / App Router
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google integrations (Stella AI)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (opcional)
NEXT_PUBLIC_WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ===== LEADS / EMAIL (CRITICO - circuito comercial) =====
# Cada solicitud del formulario #cita envia:
#   1) Aviso instantaneo a LEAD_INBOX_EMAIL con todos los datos del cliente.
#   2) Confirmacion automatica al correo del cliente.
# API key de Resend (gratis hasta 3.000 emails/mes): https://app.resend.com/api-keys
# SIN ESTA CLAVE el formulario sigue funcionando, pero NO se envian correos.
RESEND_API_KEY=
# Remitente. Para pruebas: tu email de Resend (onboarding@resend.dev).
# En produccion, un dominio verificado en Resend: LOCALIS AI <avisos@tudominio.com>
EMAIL_FROM=LOCALIS AI <onboarding@resend.dev>
# Destinatario de los avisos de nuevos leads (tu Gmail)
LEAD_INBOX_EMAIL=migueljosa7@gmail.com

# Geolocation / WebSocket (mock por defecto)
NEXT_PUBLIC_GPS_WS_URL=
NEXT_PUBLIC_API_BASE_URL=

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
