# ===== LOCALIS AI — Variables de entorno =====
# Copia a `.env.local` para desarrollo (nunca se sube a GitHub).
# En Vercel: Project Settings > Environment Variables. Tras cambiar una variable
# hay que volver a desplegar (Deployments > ... > Redeploy) para que se aplique.

# ===== BASE DE DATOS (Supabase) — leads y oportunidades =====
# SUPABASE_URL: https://<proyecto>.supabase.co (sin /rest/v1/ al final).
# Clave secreta: "Secret key" (sb_secret_…) o la antigua "service_role" (eyJ…). Solo servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== PANEL INTERNO /admin (contraseña de 16+ caracteres) =====
# Sin estas dos variables el panel no existe (responde 404).
ADMIN_USER=
ADMIN_PASSWORD=

# ===== EMAIL DE LEADS (Resend) =====
# Sin esta clave los formularios guardan en Supabase pero no se envían correos.
RESEND_API_KEY=
# Remitente. Sin dominio verificado: onboarding@resend.dev (solo entrega al email de tu cuenta de Resend).
EMAIL_FROM=LOCALIS AI <onboarding@resend.dev>
# Destinatario de los avisos de nuevos leads
LEAD_INBOX_EMAIL=

# ===== STELLA (asistente con IA) — opcional, tiene coste por uso =====
# Sin ANTHROPIC_API_KEY Stella está desactivada y la web muestra el botón de WhatsApp.
# Clave en https://platform.claude.com (API Keys). Solo servidor.
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto claude-opus-5-5. Alternativa más barata: claude-haiku-5-5.
STELLA_MODEL=

# ===== WEB =====
# URL pública canónica (SEO, sitemap). En Vercel, si se deja vacía, se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=
# Google Ads: etiqueta de conversión de cada lead ("AW-18505356053/XXXXXXXX").
NEXT_PUBLIC_GADS_LEAD_SEND_TO=
