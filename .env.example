# ===== LOCALIS AI · variables de entorno =====
# Copia a `.env.local` para desarrollo. En Vercel: Project Settings > Environment Variables.
# Solo se listan las variables que el código lee de verdad. Nunca subas valores reales al repositorio.

# --- Base de datos (Supabase): leads, Stella y diseños del configurador ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel interno /admin (la contraseña debe tener 16+ caracteres; sin ellas el panel responde 404) ---
ADMIN_USER=
ADMIN_PASSWORD=

# --- Correo de avisos de leads (Resend). Sin la clave los leads se guardan igualmente ---
RESEND_API_KEY=
EMAIL_FROM=LOCALIS AI <onboarding@resend.dev>
LEAD_INBOX_EMAIL=

# --- Web pública y SEO ---
# URL canónica del sitio (sitemap, canonical, Open Graph). Si se deja vacía en Vercel se usa el dominio de producción.
NEXT_PUBLIC_SITE_URL=
# Código de verificación de Google Search Console (método «etiqueta HTML»: solo el valor de content="...").
GOOGLE_SITE_VERIFICATION=
# Etiqueta de conversión de Google Ads ("AW-XXXXXXXXX/XXXXXXXX")
NEXT_PUBLIC_GADS_LEAD_SEND_TO=

# --- Stella (asistente con IA). Sin ANTHROPIC_API_KEY queda apagada ---
ANTHROPIC_API_KEY=
# claude-haiku-5-5 (por defecto, el más barato) o claude-sonnet-5-5
STELLA_MODEL=
# false = apaga Stella en toda la plataforma
STELLA_ENABLED=
# on = mostrar el chat real en la propia web de LOCALIS (en Producción déjalo vacío hasta validar Stella con la API real)
STELLA_SITE_WIDGET=
# Secreto para firmar sesiones de Stella (largo y aleatorio). Si falta se deriva de la clave de Supabase.
STELLA_SIGNING_SECRET=
# Topes globales de gasto de IA en dólares (opcionales)
STELLA_GLOBAL_DAILY_USD=
STELLA_GLOBAL_MONTHLY_USD=
