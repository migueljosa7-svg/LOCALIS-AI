# ===== LOCALIS AI — Variables de entorno (todas opcionales, con fallback seguro) =====
# Copia a `.env.local` para desarrollo. En Vercel: Project Settings > Environment Variables.

# Next.js / App Router
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=

# Google integrations (Stella AI)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (opcional)
NEXT_PUBLIC_WHATSAPP_BUSINESS_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Inbox de leads del endpoint /api/lead (solo servidor)
LEAD_INBOX_EMAIL=hola@localis.ai

# Geolocation / WebSocket (mock por defecto)
NEXT_PUBLIC_GPS_WS_URL=
NEXT_PUBLIC_API_BASE_URL=

# Analytics (Plausible)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
