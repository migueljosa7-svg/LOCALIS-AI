# ===== INDIVIDUAL ENVIRONMENT VARIABLES (optional) =====

# Next.js / App Router
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Google integrations (Stella AI)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# WhatsApp Cloud API (optional webhook)
NEXT_PUBLIC_WHATSAPP_BUSINESS_ID=waid_your_whatsapp_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=phone_number_id_here

# Geolocation / WebSocket (mock by default)
NEXT_PUBLIC_GPS_WS_URL=ws://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Analytics (Plausible / Cloudflare Web Analytics)
NEXT_PUBLIC_PLausible_DOMAIN=localis.ai
